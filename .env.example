# ==============================================================================
# TheHub — Environment Configuration Template
# Copy this file to .env before starting containers: cp .env.example .env
# Never commit actual secret keys or production passwords to version control.
# ==============================================================================

# Application Ports
PORT=8080
FRONTEND_PORT=3000
NGINX_PORT=80
KAFKA_UI_PORT=8085

# PostgreSQL Configuration
POSTGRES_DB=thehub
POSTGRES_USER=thehub
POSTGRES_PASSWORD=thehub_secure_password_replace_in_prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/thehub
SPRING_DATASOURCE_USERNAME=thehub
SPRING_DATASOURCE_PASSWORD=thehub_secure_password_replace_in_prod
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Redis Configuration
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Apache Kafka Configuration (KRaft Mode)
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CFG_NODE_ID=1
KAFKA_CFG_PROCESS_ROLES=controller,broker
KAFKA_CFG_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_CFG_CONTROLLER_LISTENER_NAMES=CONTROLLER

# JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:5173
